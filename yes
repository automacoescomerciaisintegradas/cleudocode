#!/bin/bash

# ==============================================================================
# SCRIPT DE CONFIGURAÇÃO DE LLMs (Linux)
# ==============================================================================

# 1. Configuração Global Padrão
# Definimos a URL base padrão conforme solicitado.
# Nota: Em um ambiente real, isso geralmente aponta para um proxy (ex: https://api.openai.com/v1 ou um local).
export ANTHROPIC_BASE_URL="https://api"

# ------------------------------------------------------------------
# Função auxiliar para simular o comando "launch claude"
# Substitua 'echo' pelo comando real que você usa para iniciar o Claude
# (ex: 'claude', 'anthropic', ou um script python).
# ------------------------------------------------------------------
_run_claude() {
    local model_name=$1
    shift # Remove o primeiro argumento (modelo) para passar o resto ($@) como flags
    
    echo "---------------------------------------------------------"
    echo "🚀 LAUNCH CLAUDE"
    echo "📍 Target URL: $ANTHROPIC_BASE_URL"
    echo "🤖 Model:      $model_name"
    echo "🚩 Flags:      $@"
    echo "---------------------------------------------------------"
    
    # DESCOMENTE A LINHA ABAIXO PARA EXECUÇÃO REAL:
    # claude --model "$model_name" "$@"
}

# ==============================================================================
# FUNÇÕES ESPECÍFICAS (Baseado no seu pedido)
# ==============================================================================

# 1. Kimi K2 launch claude
kimi_k2_launch() {
    # Configura URL para o endpoint Kimi (Moonshot AI)
    # Ajuste conforme a documentação do seu provedor
    export ANTHROPIC_BASE_URL="https://api.moonshot.cn/v1"
    
    # Executa com o modelo Kimi K2
    _run_claude "moonshot-v1-128k" "$@"
}

# 2. GLM 4.7 launch claude
glm_47_launch() {
    # Configura URL para o endpoint Zhipu AI (GLM)
    export ANTHROPIC_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
    
    # Executa com o modelo GLM 4
    _run_claude "glm-4" "$@"
}

# 3. ollama launch claude
ollama_launch_claude() {
    # Configura URL para o Ollama local
    export ANTHROPIC_BASE_URL="http://localhost:11434/v1"
    
    # Executa assumindo que você tenha um modelo Claude rodando no Ollama
    # ou um modelo compatível. "claude-3.5-sonnet" é um exemplo de nome local.
    _run_claude "claude-3.5-sonnet" "$@"
}

# 4. ollama launch claude -- config
ollama_launch_config() {
    export ANTHROPIC_BASE_URL="http://localhost:11434/v1"
    
    # Passa a flag -- config para o comando
    _run_claude "claude-3.5-sonnet" -- config "$@"
}

# 5. GLM-4-32B-0414-128K (Modelo Específico)
glm_32b_launch() {
    export ANTHROPIC_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
    
    # Usa o ID exato do modelo solicitado
    _run_claude "GLM-4-32B-0414-128K" "$@"
}

# ==============================================================================
# MENSAGEM FINAL
# ==============================================================================
echo "Configuração carregada! Comandos disponíveis:"
echo "  - kimi_k2_launch"
echo "  - glm_47_launch"
echo "  - ollama_launch_claude"
echo "  - ollama_launch_config"
echo "  - glm_32b_launch"
