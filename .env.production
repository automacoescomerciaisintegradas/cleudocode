# ============================================
# CLEUDO CODE - Welcome Agent Production
# ============================================

# =====================================
# OLLAMA SERVER CONFIGURATION
# =====================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
WELCOME_MODEL=llama3:8b

# =====================================
# TELEGRAM BOT CONFIGURATION
# =====================================
# Obtenha o token via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# =====================================
# WHATSAPP CONFIGURATION (Opcional)
# =====================================
WHATSAPP_BASE_URL=
WHATSAPP_INSTANCE_NAME=default

# =====================================
# API KEYS (Opcional - para fallback)
# =====================================
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# =====================================
# PRODUCTION SETTINGS
# =====================================
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# =====================================
# DATABASE (Opcional - para memória)
# =====================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/cleudocode

# =====================================
# REDIS (Opcional - para cache)
# =====================================
# REDIS_URL=redis://localhost:6379/0

# =====================================
# MONITORING (Opcional)
# =====================================
# SENTRY_DSN=
# TELEMETRY_ENABLED=false
